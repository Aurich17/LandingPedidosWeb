---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/sections/Header.astro";
import Pricing from "../components/sections/Pricing.astro";
import FAQ from "../components/sections/FAQ.astro";
import FinalCTA from "../components/sections/FinalCTA.astro";
import Footer from "../components/sections/Footer.astro";
import SeoLandingSection from "../components/SeoLandingSection.astro";
import { SITE, canonicalUrl } from "../lib/site";

const canonical = canonicalUrl("/precios/");
const title = "Planes Gratis y Pro | Pedidos Web";
const description =
  "Elige entre Gratis y Pro para vender por WhatsApp. Catálogo online con link para compartir y pedidos con detalle y total. Pro: S/50 al mes o $20/mes.";
---

<BaseLayout title={title} description={description} canonical={canonical}>
	<Header appUrl={SITE.appUrl} />
	<main>
		<SeoLandingSection
			eyebrow="Precios"
			title="Planes para vender por WhatsApp sin desorden"
			lead="Elige un plan, crea tu tienda y empieza a recibir pedidos claros por WhatsApp. Precios en soles (Perú)."
			bullets={[
				"Un solo enlace para compartir tu catálogo",
				"Pedidos con detalle y total por WhatsApp",
				"Soporte para emprendedores y tiendas pequeñas",
			]}
		/>
		<Pricing appUrl={SITE.appUrl} />
		<FAQ />
		<FinalCTA appUrl={SITE.appUrl} demoUrl={SITE.demoUrl} />
	</main>
	<Footer />
</BaseLayout>
