---
type Props = {
	demoUrl: string;
};

const { demoUrl } = Astro.props;
---

<section id="demo" class="demo-section">
	<div class="container">
		<div class="demo-layout">
			<div class="demo-content">
				<h2 class="demo-title">
					Mira cómo se verá tu tienda online
				</h2>

				<p class="demo-description">
					Prueba el flujo completo como cliente: explora productos, agrega al carrito y envía un pedido listo para WhatsApp.
				</p>

				<div class="demo-actions">
					<a
						class="demo-btn demo-btn-primary"
						href={demoUrl}
						target="_blank"
						rel="noopener"
					>
						Abrir tienda demo
					</a>

					<div class="demo-note">
						No necesitas instalar nada
					</div>
				</div>

				<div class="demo-points">
					<div class="demo-point">
						<span>✔</span>
						Catálogo online listo para compartir
					</div>

					<div class="demo-point">
						<span>✔</span>
						Pedidos con detalle y total
					</div>

					<div class="demo-point">
						<span>✔</span>
						Optimizado para celular
					</div>
				</div>
			</div>

			<div class="demo-preview">
				<div class="preview-window">
					<div class="preview-header">
						<div class="preview-dots">
							<span></span>
							<span></span>
							<span></span>
						</div>

						<div class="preview-url">
							tutienda.pedidosweb.shop
						</div>
					</div>

					<div class="preview-body">
						<div class="preview-store">
							<div class="preview-store-avatar"></div>

							<div>
								<div class="preview-store-title">
									Tienda Demo
								</div>

								<div class="preview-store-subtitle">
									Pide fácil desde WhatsApp
								</div>
							</div>
						</div>

						<div class="preview-products">
							<div class="preview-card">
								<img
									src="/landing_demo/hamburguesa.webp"
									alt="Hamburguesa"
									loading="lazy"
								/>

								<div class="preview-product-info">
									<div>
										<h4>Hamburguesa</h4>
										<p>S/ 45</p>
									</div>

									<button>
										Agregar
									</button>
								</div>
							</div>

							<div class="preview-card">
								<img
									src="/landing_demo/salchipapa.jpg"
									alt="Salchipapa"
									loading="lazy"
								/>

								<div class="preview-product-info">
									<div>
										<h4>Salchipapa</h4>
										<p>S/ 32</p>
									</div>

									<button>
										Agregar
									</button>
								</div>
							</div>

							<div class="preview-card">
								<img
									src="/landing_demo/broster.avif"
									alt="Broster"
									loading="lazy"
								/>

								<div class="preview-product-info">
									<div>
										<h4>Broster</h4>
										<p>S/ 18</p>
									</div>

									<button>
										Agregar
									</button>
								</div>
							</div>

							<div class="preview-card">
								<img
									src="/landing_demo/Hot_dog.png"
									alt="Hot dog"
									loading="lazy"
								/>

								<div class="preview-product-info">
									<div>
										<h4>Hot dog</h4>
										<p>S/ 29</p>
									</div>

									<button>
										Agregar
									</button>
								</div>
							</div>
						</div>

						<div class="preview-footer">
							<div class="preview-total">
								<span>Total</span>
								<strong>S/ 124</strong>
							</div>

							<div class="preview-whatsapp">
								Enviar pedido por WhatsApp
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.demo-section {
		position: relative;
		padding: 110px 0;
		background:
			radial-gradient(
				circle at top right,
				rgba(37, 211, 102, 0.08),
				transparent 35%
			),
			linear-gradient(
				to bottom,
				#ffffff,
				#f8fafc
			);
		overflow: hidden;
	}

	.demo-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 70px;
		align-items: center;
	}

	.demo-content {
		max-width: 620px;
	}

	.demo-title {
		font-size: clamp(42px, 5vw, 68px);
		line-height: 0.98;
		font-weight: 950;
		letter-spacing: -0.05em;
		color: #0f172a;
	}

	.demo-description {
		margin-top: 26px;
		font-size: 18px;
		line-height: 1.9;
		color: #64748b;
		font-weight: 500;
		max-width: 560px;
	}

	.demo-actions {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		margin-top: 34px;
	}

	.demo-btn {
		height: 58px;
		padding: 0 28px;
		border-radius: 18px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		font-size: 16px;
		font-weight: 800;
		transition: 0.25s ease;
	}

	.demo-btn-primary {
		background:
			linear-gradient(
				180deg,
				#22c55e,
				#16a34a
			);
		color: white;
		box-shadow:
			0 16px 40px rgba(34, 197, 94, 0.22);
	}

	.demo-btn-primary:hover {
		transform: translateY(-2px);
		box-shadow:
			0 22px 50px rgba(34, 197, 94, 0.28);
	}

	.demo-note {
		height: 44px;
		padding: 0 18px;
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(15, 23, 42, 0.06);
		font-size: 14px;
		font-weight: 700;
		color: #64748b;
	}

	.demo-points {
		display: flex;
		flex-direction: column;
		gap: 16px;
		margin-top: 34px;
	}

	.demo-point {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 16px;
		font-weight: 600;
		color: #475569;
	}

	.demo-point span {
		color: #22c55e;
		font-size: 18px;
		font-weight: 900;
	}

	.demo-preview {
		display: flex;
		justify-content: center;
	}

	.preview-window {
		width: 100%;
		max-width: 580px;
		background: rgba(255, 255, 255, 0.92);
		border: 1px solid rgba(15, 23, 42, 0.06);
		border-radius: 32px;
		overflow: hidden;
		backdrop-filter: blur(12px);
		box-shadow:
			0 30px 80px rgba(15, 23, 42, 0.08);
	}

	.preview-header {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 18px 20px;
		border-bottom: 1px solid rgba(15, 23, 42, 0.06);
	}

	.preview-dots {
		display: flex;
		gap: 6px;
	}

	.preview-dots span {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: rgba(100, 116, 139, 0.4);
	}

	.preview-url {
		flex: 1;
		height: 38px;
		border-radius: 999px;
		border: 1px solid rgba(15, 23, 42, 0.08);
		display: flex;
		align-items: center;
		padding: 0 14px;
		font-size: 13px;
		color: #64748b;
		font-weight: 600;
	}

	.preview-body {
		padding: 22px;
	}

	.preview-store {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 18px;
		border-radius: 24px;
		background:
			linear-gradient(
				180deg,
				rgba(37, 211, 102, 0.12),
				rgba(37, 211, 102, 0.04)
			);
		border: 1px solid rgba(37, 211, 102, 0.10);
	}

	.preview-store-avatar {
		width: 52px;
		height: 52px;
		border-radius: 18px;
		background:
			linear-gradient(
				180deg,
				#22c55e,
				#16a34a
			);
	}

	.preview-store-title {
		font-size: 20px;
		font-weight: 900;
		color: #0f172a;
	}

	.preview-store-subtitle {
		margin-top: 4px;
		font-size: 14px;
		color: #64748b;
		font-weight: 600;
	}

	.preview-products {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
		margin-top: 22px;
	}

	.preview-card {
		background: white;
		border-radius: 22px;
		padding: 14px;
		border: 1px solid rgba(15, 23, 42, 0.06);
		box-shadow:
			0 10px 30px rgba(15, 23, 42, 0.03);
	}

	.preview-card img {
		width: 100%;
		height: 120px;
		object-fit: cover;
		border-radius: 16px;
	}

	.preview-product-info {
		margin-top: 14px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}

	.preview-product-info h4 {
		font-size: 15px;
		font-weight: 800;
		color: #0f172a;
	}

	.preview-product-info p {
		margin-top: 4px;
		font-size: 14px;
		color: #64748b;
		font-weight: 600;
	}

	.preview-product-info button {
		height: 40px;
		padding: 0 14px;
		border-radius: 14px;
		border: none;
		background: rgba(37, 211, 102, 0.12);
		color: #16a34a;
		font-size: 14px;
		font-weight: 800;
		cursor: pointer;
		transition: 0.25s ease;
	}

	.preview-product-info button:hover {
		background: rgba(37, 211, 102, 0.18);
	}

	.preview-footer {
		margin-top: 24px;
		padding-top: 22px;
		border-top: 1px solid rgba(15, 23, 42, 0.06);
	}

	.preview-total {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 18px;
		font-weight: 900;
		color: #0f172a;
	}

	.preview-whatsapp {
		margin-top: 16px;
		height: 56px;
		border-radius: 18px;
		display: flex;
		align-items: center;
		justify-content: center;
		background:
			linear-gradient(
				180deg,
				#22c55e,
				#16a34a
			);
		color: white;
		font-size: 16px;
		font-weight: 900;
		box-shadow:
			0 14px 40px rgba(34, 197, 94, 0.22);
	}

	@media (max-width: 1100px) {
		.demo-layout {
			grid-template-columns: 1fr;
			gap: 50px;
		}
	}

	@media (max-width: 768px) {
		.demo-section {
			padding: 80px 0;
		}

		.demo-title {
			font-size: 42px;
		}

		.demo-description {
			font-size: 16px;
		}
	}

	@media (max-width: 560px) {
		.demo-title {
			font-size: 36px;
		}

		.preview-products {
			grid-template-columns: 1fr;
		}

		.demo-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.demo-btn {
			width: 100%;
		}
	}
</style>