---
type Props = {
	appUrl: string;
	demoUrl: string;
};

const { appUrl, demoUrl } = Astro.props;
---

<section class="section">
	<div class="container">
		<div class="cta">
			<div class="cta-copy">
				<h2 class="h2">Haz que tus clientes pidan por WhatsApp, pero sin desorden</h2>
				<p class="lead">Crea tu cuenta, sube tus productos y comparte tu enlace hoy mismo.</p>
			</div>
			<div class="cta-actions">
				<a class="btn btn-primary" href={appUrl}>Crear mi tienda</a>
				<a class="btn btn-secondary" href={demoUrl} target="_blank" rel="noopener">Ver demo</a>
			</div>
		</div>
	</div>
</section>

<style>
	.cta {
		border-radius: 24px;
		border: 1px solid rgba(37, 211, 102, 0.24);
		background:
			radial-gradient(900px 360px at 15% 20%, rgba(37, 211, 102, 0.20), transparent 55%),
			radial-gradient(900px 360px at 90% 40%, rgba(59, 130, 246, 0.18), transparent 55%),
			linear-gradient(180deg, rgba(37, 211, 102, 0.08), rgba(59, 130, 246, 0.06));
		padding: 26px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		box-shadow:
			0 22px 70px rgba(29, 185, 84, 0.12),
			0 22px 70px rgba(59, 130, 246, 0.10);
	}

	.cta-copy {
		max-width: 720px;
	}

	.cta-actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	@media (max-width: 920px) {
		.cta {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
