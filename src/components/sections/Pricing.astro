---
type Props = {
	appUrl: string;
	whatsappUrl: string;
};

const { appUrl, whatsappUrl } = Astro.props;
---

<section id="precios" class="section pricing">
	<div class="container">
		<div class="head">
			<span class="eyebrow">Precios</span>
			<h2 class="h2">Planes simples para vender por WhatsApp</h2>
			<p class="lead">Precios en soles (Perú). Disponible para otros países.</p>
		</div>

		<div class="grid grid--3 plans">
			<div class="card plan">
				<div class="plan-top">
					<div class="plan-name">Básico</div>
					<div class="plan-price">
						<span class="price">S/ 20</span><span class="per">/ mes</span>
					</div>
				</div>
				<ul class="plan-list">
					<li>Catálogo online</li>
					<li>Enlace para compartir</li>
					<li>Pedidos a WhatsApp</li>
					<li>Soporte estándar</li>
				</ul>
				<a class="btn btn-secondary plan-cta" href={appUrl}>Empezar</a>
			</div>

			<div class="card plan card--highlight">
				<div class="badge">Recomendado</div>
				<div class="plan-top">
					<div class="plan-name">Pro</div>
					<div class="plan-price">
						<span class="price">S/ 30</span><span class="per">/ mes</span>
					</div>
				</div>
				<ul class="plan-list">
					<li>Todo lo del Básico</li>
					<li>Opciones (talla, color, sabor)</li>
					<li>Pedido con detalle y total</li>
					<li>Personalización (logo y colores)</li>
					<li>Soporte prioritario</li>
				</ul>
				<a class="btn btn-primary plan-cta" href={appUrl}>Crear mi tienda</a>
			</div>

			<div class="card plan">
				<div class="plan-top">
					<div class="plan-name">Premium</div>
					<div class="plan-price">
						<span class="price">S/ 60</span><span class="per">/ mes</span>
					</div>
				</div>
				<ul class="plan-list">
					<li>Todo lo del Pro</li>
					<li>Dominio propio (próximamente)</li>
					<li>Reportes y métricas (próximamente)</li>
					<li>Integraciones (próximamente)</li>
				</ul>
				<a class="btn btn-secondary plan-cta" href={whatsappUrl} target="_blank" rel="noopener">Hablar con ventas</a>
			</div>
		</div>
	</div>
</section>

<style>
	.pricing {
		background: linear-gradient(180deg, rgba(59, 130, 246, 0.10), transparent);
	}

	.head {
		max-width: 820px;
	}

	.plans {
		margin-top: 18px;
	}

	.plan {
		position: relative;
		padding: 20px;
	}

	.plan.card--highlight {
		padding-top: 48px;
	}

	.badge {
		position: absolute;
		top: 16px;
		left: 16px;
		right: auto;
		background: rgba(37, 211, 102, 0.14);
		color: var(--brand);
		border: 1px solid rgba(37, 211, 102, 0.20);
		border-radius: 999px;
		padding: 6px 10px;
		font-weight: 800;
		font-size: 12px;
		z-index: 2;
	}

	.plan-top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
	}

	.plan-name {
		font-weight: 900;
		letter-spacing: -0.02em;
		font-size: 18px;
	}

	.plan-price {
		display: flex;
		align-items: baseline;
		gap: 6px;
	}

	.price {
		font-weight: 950;
		font-size: 24px;
	}

	.per {
		color: var(--muted);
		font-weight: 700;
	}

	.plan-list {
		margin: 16px 0 18px;
		padding-left: 18px;
		color: var(--muted);
		display: grid;
		gap: 10px;
		font-weight: 650;
	}

	.plan-cta {
		width: 100%;
	}
</style>
