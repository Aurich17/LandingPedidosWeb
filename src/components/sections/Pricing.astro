---
type Props = {
	appUrl: string;
};

const { appUrl } = Astro.props;
---

<section id="precios" class="pricing-section">
	<div class="container">
		<div class="pricing-head">
			<h2 class="pricing-title">
				Planes simples para vender por WhatsApp
			</h2>

			<p class="pricing-subtitle">
				Empieza gratis y escala cuando tu negocio crezca.
			</p>
		</div>

		<div class="pricing-grid">
			<!-- GRATIS -->
			<div class="pricing-card">
				<div class="pricing-card-header">
					<div>

						<h3 class="pricing-plan-name">Gratis</h3>
					</div>

					<div class="pricing-price-wrapper">
						<div class="pricing-price">S/ 0</div>
						<div class="pricing-price-alt">$0</div>
					</div>
				</div>

				<p class="pricing-description">
					Empieza a recibir pedidos por WhatsApp en minutos.
				</p>

				<ul class="pricing-features">
					<li>Hasta 20 productos</li>
					<li>Catálogo online</li>
					<li>Pedidos directo a WhatsApp</li>
					<li>Link para compartir</li>
					<li>Personalización básica</li>
					<li>Subdominio gratis</li>
					<li>Soporte estándar</li>
				</ul>

				<a href={appUrl} class="pricing-btn pricing-btn-secondary">
					Empezar gratis
				</a>
			</div>

			<!-- PRO -->
			<div class="pricing-card pricing-card-highlight">
				<div class="pricing-card-header">
					<div>
						<h3 class="pricing-plan-name">Pro</h3>
					</div>

					<div class="pricing-price-wrapper">
						<div class="pricing-price">
							S/ 50
							<span>/ mes</span>
						</div>

						<div class="pricing-price-alt">
							$20 / month
						</div>
					</div>
				</div>

				<p class="pricing-description">
					Todo lo que necesitas para vender profesionalmente por WhatsApp.
				</p>

				<ul class="pricing-features">
					<li>Productos ilimitados</li>
					<li>Pedidos ilimitados</li>
					<li>Variantes de productos</li>
					<li>Logo y colores personalizados</li>
					<li>Pedido con detalle y total</li>
					<li>Catálogo profesional</li>
					<li>Sin marca de PedidosWeb</li>
					<li>Prioridad en soporte</li>
					<li>Estadísticas básicas</li>
				</ul>

				<a href={appUrl} class="pricing-btn pricing-btn-primary">
					Crear mi tienda
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.pricing-section {
		padding: 110px 0;
		background:
			radial-gradient(circle at top, rgba(37, 211, 102, 0.08), transparent 40%),
			linear-gradient(to bottom, #ffffff, #f8fafc);
	}

	.pricing-head {
		text-align: center;
		max-width: 760px;
		margin: 0 auto 60px;
	}

	.pricing-tag {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 8px 14px;
		border-radius: 999px;
		background: rgba(37, 211, 102, 0.12);
		color: #16a34a;
		font-size: 13px;
		font-weight: 800;
		margin-bottom: 18px;
	}

	.pricing-title {
		font-size: clamp(36px, 5vw, 60px);
		line-height: 1;
		font-weight: 950;
		letter-spacing: -0.05em;
		color: #0f172a;
	}

	.pricing-subtitle {
		margin-top: 18px;
		font-size: 18px;
		line-height: 1.7;
		color: #475569;
		font-weight: 500;
	}

	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 28px;
		align-items: stretch;
	}

	.pricing-card {
		position: relative;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(15, 23, 42, 0.08);
		border-radius: 28px;
		padding: 34px;
		display: flex;
		flex-direction: column;
		box-shadow:
			0 10px 40px rgba(15, 23, 42, 0.04);
	}

	.pricing-card-highlight {
		border: 2px solid rgba(37, 211, 102, 0.25);
		box-shadow:
			0 25px 60px rgba(37, 211, 102, 0.12);
		transform: translateY(-8px);
	}

	.pricing-popular {
		position: absolute;
		top: -14px;
		left: 32px;
		background: #22c55e;
		color: white;
		font-size: 13px;
		font-weight: 800;
		padding: 10px 16px;
		border-radius: 999px;
		box-shadow:
			0 10px 25px rgba(34, 197, 94, 0.25);
	}

	.pricing-card-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
	}

	.pricing-badge {
		display: inline-flex;
		padding: 8px 14px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 800;
		margin-bottom: 18px;
	}

	.pricing-badge-light {
		background: rgba(15, 23, 42, 0.06);
		color: #0f172a;
	}

	.pricing-plan-name {
		font-size: 28px;
		font-weight: 900;
		letter-spacing: -0.03em;
		color: #0f172a;
	}

	.pricing-price-wrapper {
		text-align: right;
	}

	.pricing-price {
		font-size: 42px;
		font-weight: 950;
		letter-spacing: -0.05em;
		color: #0f172a;
		line-height: 1;
	}

	.pricing-price span {
		font-size: 16px;
		color: #64748b;
		font-weight: 700;
	}

	.pricing-price-alt {
		margin-top: 8px;
		font-size: 14px;
		color: #64748b;
		font-weight: 700;
	}

	.pricing-description {
		margin-top: 24px;
		font-size: 16px;
		line-height: 1.7;
		color: #475569;
		font-weight: 500;
	}

	.pricing-features {
		list-style: none;
		padding: 0;
		margin: 30px 0;
		display: grid;
		gap: 14px;
	}

	.pricing-features li {
		position: relative;
		padding-left: 28px;
		font-size: 16px;
		font-weight: 600;
		color: #0f172a;
		line-height: 1.5;
	}

	.pricing-features li::before {
		content: "✓";
		position: absolute;
		left: 0;
		top: 0;
		color: #22c55e;
		font-weight: 900;
	}

	.pricing-btn {
		margin-top: auto;
		height: 58px;
		border-radius: 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		font-size: 16px;
		font-weight: 800;
		transition: 0.25s ease;
	}

	.pricing-btn-primary {
		background: #22c55e;
		color: white;
		box-shadow:
			0 10px 30px rgba(34, 197, 94, 0.22);
	}

	.pricing-btn-primary:hover {
		transform: translateY(-2px);
		background: #16a34a;
	}

	.pricing-btn-secondary {
		background: white;
		border: 1px solid rgba(15, 23, 42, 0.1);
		color: #0f172a;
	}

	.pricing-btn-secondary:hover {
		background: rgba(15, 23, 42, 0.03);
		transform: translateY(-2px);
	}

	.pricing-faq {
		margin-top: 40px;
		padding: 28px;
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(15, 23, 42, 0.06);
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px;
	}

	.faq-item {
		padding: 6px;
	}

	.faq-question {
		font-size: 15px;
		font-weight: 800;
		color: #0f172a;
	}

	.faq-answer {
		margin-top: 8px;
		font-size: 14px;
		line-height: 1.6;
		color: #64748b;
		font-weight: 500;
	}

	@media (max-width: 900px) {
		.pricing-grid {
			grid-template-columns: 1fr;
		}

		.pricing-card-highlight {
			transform: none;
		}

		.pricing-faq {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.pricing-section {
			padding: 80px 0;
		}

		.pricing-card {
			padding: 24px;
			border-radius: 24px;
		}

		.pricing-title {
			font-size: 40px;
		}

		.pricing-price {
			font-size: 34px;
		}

		.pricing-card-header {
			flex-direction: column;
			align-items: flex-start;
		}

		.pricing-price-wrapper {
			text-align: left;
		}
	}
</style>