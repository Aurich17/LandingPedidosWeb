---
import { SITE } from "../../lib/site";

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="container">
		<div class="footer-top">
			<div class="footer-brand">
				<img
					class="footer-logo"
					src="/logo.png"
					alt="Pedidos Web"
				/>

				<p class="footer-description">
					Crea tu catálogo online, comparte un solo enlace y recibe pedidos organizados directamente en WhatsApp.
				</p>

				<a
					class="footer-contact"
					href={SITE.whatsappUrl}
					target="_blank"
					rel="noopener"
				>
					<img
						src="/ico_web.png"
						alt=""
						aria-hidden="true"
					/>

					<span>
						{SITE.contactPhoneDisplay}
					</span>
				</a>
			</div>

			<div class="footer-links">
				<div class="footer-column">
					<h3>Producto</h3>

					<a href="/#como-funciona">
						Cómo funciona
					</a>

					<a href="/#caracteristicas">
						Características
					</a>

					<a href="/#precios">
						Precios
					</a>

					<a href="/#faq">
						Preguntas frecuentes
					</a>
				</div>

				<div class="footer-column">
					<h3>Recursos</h3>

					<a href="/blog/">
						Blog
					</a>

					<a href="/">
						Demo
					</a>

					<a href="/">
						Inicio
					</a>
				</div>

				<div class="footer-column">
					<h3>Soluciones</h3>

					<a href="/catalogo-para-whatsapp/">
						Catálogo para WhatsApp
					</a>

					<a href="/tienda-online-para-whatsapp/">
						Tienda online para WhatsApp
					</a>

					<a href="/recibir-pedidos-por-whatsapp/">
						Recibir pedidos por WhatsApp
					</a>
				</div>

				<div class="footer-column">
					<h3>Empresa</h3>

					<a href="/sobre-nosotros/">
						Sobre nosotros
					</a>

					<a href="/contacto/">
						Contacto
					</a>

					<a href="/politica-de-privacidad/">
						Privacidad
					</a>

					<a href="/terminos-y-condiciones/">
						Términos
					</a>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<div class="footer-copy">
				© {year} PedidosWeb. Todos los derechos reservados.
			</div>

			<div class="footer-made">
				Hecho para negocios que venden por WhatsApp.
			</div>
		</div>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		padding: 100px 0 36px;
		background:
			radial-gradient(
				circle at top left,
				rgba(37, 211, 102, 0.06),
				transparent 30%
			),
			#ffffff;
		border-top: 1px solid rgba(15, 23, 42, 0.06);
		overflow: hidden;
	}

	.footer-top {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 80px;
		align-items: start;
	}

	.footer-brand {
		max-width: 520px;
	}

	.footer-logo {
		width: 100%;
		max-width: 240px;
		height: auto;
		object-fit: contain;
	}

	.footer-description {
		margin-top: 24px;
		font-size: 17px;
		line-height: 1.9;
		color: #64748b;
		font-weight: 500;
		max-width: 480px;
	}

	.footer-contact {
		margin-top: 28px;
		display: inline-flex;
		align-items: center;
		gap: 12px;
		height: 52px;
		padding: 0 20px;
		border-radius: 16px;
		background: rgba(37, 211, 102, 0.10);
		border: 1px solid rgba(37, 211, 102, 0.14);
		text-decoration: none;
		color: #0f172a;
		font-size: 15px;
		font-weight: 800;
		transition: 0.25s ease;
	}

	.footer-contact:hover {
		transform: translateY(-2px);
		background: rgba(37, 211, 102, 0.14);
	}

	.footer-contact img {
		width: 18px;
		height: 18px;
		object-fit: contain;
	}

	.footer-links {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 34px;
	}

	.footer-column {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.footer-column h3 {
		font-size: 15px;
		font-weight: 900;
		letter-spacing: -0.02em;
		color: #0f172a;
		margin-bottom: 6px;
	}

	.footer-column a {
		text-decoration: none;
		font-size: 15px;
		line-height: 1.6;
		color: #64748b;
		font-weight: 600;
		transition: 0.2s ease;
	}

	.footer-column a:hover {
		color: #0f172a;
		transform: translateX(2px);
	}

	.footer-bottom {
		margin-top: 70px;
		padding-top: 24px;
		border-top: 1px solid rgba(15, 23, 42, 0.06);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.footer-copy,
	.footer-made {
		font-size: 14px;
		color: #94a3b8;
		font-weight: 600;
	}

	@media (max-width: 1100px) {
		.footer-top {
			grid-template-columns: 1fr;
			gap: 50px;
		}
	}

	@media (max-width: 900px) {
		.footer-links {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 30px;
		}
	}

	@media (max-width: 640px) {
		.footer {
			padding: 80px 0 30px;
		}

		.footer-links {
			grid-template-columns: 1fr;
		}

		.footer-description {
			font-size: 16px;
		}

		.footer-bottom {
			margin-top: 50px;
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>